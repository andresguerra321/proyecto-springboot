<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.campus.rentaequipos</groupId>
		<artifactId>renta-equipos-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>bootstrap</artifactId>
	<packaging>jar</packaging>
	<name>bootstrap</name>
	<description>Módulo Bootstrap y Ensamblador Spring Boot</description>

	<dependencies>
		<!-- Módulos de Dominio -->
		<dependency>
			<groupId>com.campus.rentaequipos</groupId>
			<artifactId>shared-kernel</artifactId>
		</dependency>
		<dependency>
			<groupId>com.campus.rentaequipos</groupId>
			<artifactId>identity</artifactId>
		</dependency>
		<dependency>
			<groupId>com.campus.rentaequipos</groupId>
			<artifactId>catalog</artifactId>
		</dependency>
		<dependency>
			<groupId>com.campus.rentaequipos</groupId>
			<artifactId>rental</artifactId>
		</dependency>
		<dependency>
			<groupId>com.campus.rentaequipos</groupId>
			<artifactId>billing</artifactId>
		</dependency>
		<dependency>
			<groupId>com.campus.rentaequipos</groupId>
			<artifactId>reporting</artifactId>
		</dependency>

		<!-- Starters de Spring Boot -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
		</dependency>
		<!-- Flyway Migrations -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Solo el módulo bootstrap genera el fat JAR ejecutable -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>com.campus.rentaequipos.RentaEquiposApplication</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
